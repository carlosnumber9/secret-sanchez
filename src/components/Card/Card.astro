---
import { Card as CardPrimitive, CardContent } from "@/components/ui/card";
import { cn } from "@/lib/utils";

interface Props {
  tone?: "plain" | "warm" | "accent";
  class?: string;
}

const { tone = "plain", class: className } = Astro.props;
const toneClasses = {
  plain: "",
  warm: "bg-[var(--glass-secondary)]",
  accent: "bg-[var(--glass-card)] ring-primary/20"
} as const;
---

<CardPrimitive className={cn(toneClasses[tone], className)}>
  <CardContent>
    <slot />
  </CardContent>
</CardPrimitive>
