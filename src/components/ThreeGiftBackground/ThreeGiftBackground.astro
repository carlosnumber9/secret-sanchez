<div class="three-gift-background" data-three-gift-background aria-hidden="true">
  <img class="static-gift" src="/favicon.svg" alt="" width="120" height="120" />
  <canvas data-three-gift-canvas></canvas>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-three-gift-background]");
  if (root) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const smallScreen = window.matchMedia("(max-width: 640px)");
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    let dispose: (() => void) | undefined;
    let generation = 0;
    let suspended = false;
    async function update() {
      const current = ++generation;
      dispose?.();
      dispose = undefined;
      if (suspended || reducedMotion.matches || smallScreen.matches || connection?.saveData) return;
      try {
        const { initializeGiftBackground } = await import("./scene");
        if (current === generation && !suspended) dispose = initializeGiftBackground(root!);
      } catch { /* The static gift remains available without WebGL. */ }
    }
    function schedule() {
      if (typeof window.requestIdleCallback === "function") window.requestIdleCallback(() => void update(), { timeout: 2000 });
      else window.setTimeout(() => void update(), 300);
    }
    reducedMotion.addEventListener("change", () => void update());
    smallScreen.addEventListener("change", () => void update());
    window.addEventListener("pagehide", () => { suspended = true; generation++; dispose?.(); dispose = undefined; });
    window.addEventListener("pageshow", (event) => { if (event.persisted) { suspended = false; schedule(); } });
    schedule();
  }
</script>

<style>
  .three-gift-background {
    position: fixed;
    z-index: 0;
    inset: -0.5rem;
    overflow: hidden;
    pointer-events: none;
    opacity: 0.42;
    filter: blur(2.5px);
    contain: strict;
  }

  .static-gift { position: absolute; width: 120px; height: 120px; top: 30%; left: 12%; opacity: 0.5; }
  [data-scene-ready="true"] .static-gift { display: none; }

  .three-gift-background canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 640px) {
    .three-gift-background {
      opacity: 0.34;
      filter: blur(2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .three-gift-background {
      opacity: 0.24;
      filter: blur(3px);
    }
  }
</style>
