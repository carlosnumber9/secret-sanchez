---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

interface Props {
  href?: string;
  id?: string;
  class?: string;
  disabled?: boolean;
  type?: "button" | "submit" | "reset";
  variant?: "primary" | "secondary" | "ghost";
  size?: "normal" | "large";
}

const {
  href,
  id,
  class: className,
  disabled = false,
  type = "button",
  variant = "primary",
  size = "normal"
} = Astro.props;
const presetVariant = variant === "primary" ? "default" : variant;
const presetSize = size === "large" ? "lg" : "default";
const classes = cn(buttonVariants({ variant: presetVariant, size: presetSize }), className);
---

{
  href ? (
    <a class={classes} href={href}>
      <slot />
    </a>
  ) : (
    <button id={id} class={classes} type={type} disabled={disabled}>
      <slot />
    </button>
  )
}
