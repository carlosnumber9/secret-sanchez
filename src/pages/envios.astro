---
import DeliveryStatusPanel from "@/components/react/DeliveryStatusPanel/DeliveryStatusPanel";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getAdminAppState } from "@/actions/adminData";

const state = await getAdminAppState(Astro.locals.admin.id);
---

<AdminLayout title="Envíos">
  <div class="section-header">
    <h1>Envíos</h1>
    <p>Estado de mensajes por persona, con acciones sencillas para reintentar o copiar el enlace secreto.</p>
  </div>
  {
    state.draw ? (
      <DeliveryStatusPanel client:load deliveries={state.deliveries} />
    ) : (
      <p>Todavía no hay un sorteo real. Genera uno antes de preparar los envíos.</p>
    )
  }
</AdminLayout>
