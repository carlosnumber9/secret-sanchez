---
import Button from "@/components/Button/Button.astro";
import Card from "@/components/Card/Card.astro";
import StatusBadge from "@/components/StatusBadge/StatusBadge.astro";
import GroupSetup from "@/components/react/GroupSetup/GroupSetup";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getAdminAppState } from "@/actions/adminData";

const state = await getAdminAppState(Astro.locals.admin.id);
const activeParticipants = state.participants.filter((participant) => participant.active);
const missingContactCount = activeParticipants.filter(
  (participant) =>
    (participant.preferredChannel === "email" && !participant.email) ||
    participant.preferredChannel === "whatsapp" ||
    participant.preferredChannel === "both"
).length;
---

<AdminLayout title="Inicio">
  {
    state.group ? (
      <section class="hero-panel">
    <div class="section-header">
      <p>Preparando Reyes sin líos</p>
      <h1>{state.group.name}</h1>
      <p>
        Todo lo importante a la vista: familia, contactos, sorteo y mensajes secretos para cada persona.
      </p>
    </div>
    <div class="hero-kpis">
      <div class="hero-kpi">
        <span>Familia</span>
        <strong>Creada</strong>
      </div>
      <div class="hero-kpi">
        <span>Participantes</span>
        <strong>{activeParticipants.length}</strong>
      </div>
      <div class="hero-kpi">
        <span>Sin contacto</span>
        <strong>{missingContactCount}</strong>
      </div>
      <div class="hero-kpi">
        <span>Sorteo</span>
        <strong>{state.draw ? "Realizado" : "No realizado"}</strong>
      </div>
    </div>
    <div class="cluster cluster--actions">
      <Button class="min-h-11" href="/familia" size="large">Preparar sorteo</Button>
      <Button class="min-h-11" href="/sorteo" variant="secondary" size="large">Ir al reparto</Button>
    </div>
      </section>
    ) : (
      <Card tone="accent">
        <div class="stack">
          <h1>Crea el grupo familiar</h1>
          <p>Este formulario creará el primer grupo directamente en Supabase.</p>
          <GroupSetup client:load />
        </div>
      </Card>
    )
  }

  {state.group && <section class="two-column">
    <Card>
      <div class="stack">
        <div class="section-header">
          <h2>Qué falta</h2>
          <p>Juan debería ver siempre el siguiente paso claro, sin tener que buscar entre opciones.</p>
        </div>
        <div class="cluster">
          <StatusBadge tone="ok">Familia creada</StatusBadge>
          <StatusBadge tone={missingContactCount ? "warning" : "ok"}>{missingContactCount} por corregir</StatusBadge>
          <StatusBadge tone={state.draw ? "ok" : "neutral"}>{state.draw ? "Sorteo realizado" : "Sorteo pendiente"}</StatusBadge>
        </div>
      </div>
    </Card>
    <Card tone="warm">
      <div class="stack">
        <h2>Datos reales</h2>
        <p>Local y Vercel comparten esta misma familia. Revisa bien los datos antes de sortear o enviar.</p>
        <Button class="min-h-10" href="/familia" variant="secondary">Revisar familia</Button>
      </div>
    </Card>
  </section>}
</AdminLayout>
