---
import Button from "@/components/Button/Button.astro";
import Card from "@/components/Card/Card.astro";
import StatusBadge from "@/components/StatusBadge/StatusBadge.astro";
import GroupSetup from "@/components/react/GroupSetup/GroupSetup";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getAdminAppState } from "@/actions/adminData";

const state = await getAdminAppState(Astro.locals.admin.id);
---

<AdminLayout title="Inicio">
  {state.family ? (
    <>
      <section class="hero-panel">
        <div class="section-header">
          <p>Tu familia, preparada para cada edición</p>
          <h1>{state.family.name}</h1>
          <p>El censo se mantiene una sola vez y cada edición decide quién participa en su reparto.</p>
        </div>
        <div class="hero-kpis">
          <div class="hero-kpi"><span>Núcleos</span><strong>{state.islands.length}</strong></div>
          <div class="hero-kpi"><span>Familiares</span><strong>{state.participants.length}</strong></div>
          <div class="hero-kpi"><span>Ediciones</span><strong>{state.editions.length}</strong></div>
          <div class="hero-kpi"><span>Definitivas</span><strong>{state.editions.filter((edition) => edition.kind === "final").length}</strong></div>
        </div>
        <div class="cluster cluster--actions">
          <Button href="/familia" size="large">Gestionar familia</Button>
          <Button href="/ediciones/nueva" variant="secondary" size="large">Crear edición</Button>
        </div>
      </section>
      <section class="two-column">
        <Card><div class="stack"><h2>Familia maestra</h2><p>Los cambios futuros se preparan para todas las ediciones sin alterar repartos ya generados.</p><StatusBadge tone="ok">{state.participants.length} personas</StatusBadge></div></Card>
        <Card tone="warm"><div class="stack"><h2>Pruebas sin límite</h2><p>Crea ediciones de prueba, revoca repartos y vuelve a lanzarlos cuando lo necesites.</p><Button href="/ediciones" variant="secondary">Ver ediciones</Button></div></Card>
      </section>
    </>
  ) : (
    <Card tone="accent"><div class="stack"><h1>Crea la familia</h1><p>Será el censo permanente para todas las ediciones.</p><GroupSetup client:load /></div></Card>
  )}
</AdminLayout>
