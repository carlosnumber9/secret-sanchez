---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Confirmando acceso | Secret Sánchez">
  <main>
    <div class="page-shell auth-callback">
      <section class="auth-callback__panel">
        <p class="muted">Acceso seguro</p>
        <h1>Confirmando tu sesión...</h1>
        <p id="auth-callback-message">Estamos validando el enlace de Supabase.</p>
        <p class="auth-callback__debug" id="auth-callback-debug"></p>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  const message = document.querySelector<HTMLElement>("#auth-callback-message");
  const debug = document.querySelector<HTMLElement>("#auth-callback-debug");

  function setMessage(text: string) {
    if (message) message.textContent = text;
  }

  function setDebug(text: string) {
    if (debug) debug.textContent = text;
  }

  function getSafeNext(value: string | null) {
    if (!value || !value.startsWith("/") || value.startsWith("//")) return "/inicio";
    return value;
  }

  function getHashParams() {
    const hash = window.location.hash.replace(/^#/, "");
    const queryStart = hash.indexOf("?");
    return new URLSearchParams(queryStart >= 0 ? hash.slice(queryStart + 1) : hash);
  }

  async function confirmSession() {
    const searchParams = new URLSearchParams(window.location.search);
    const hashParams = getHashParams();
    const error = searchParams.get("error_description") || hashParams.get("error_description");

    if (error) {
      setMessage(`Supabase ha rechazado el enlace: ${error}`);
      return;
    }

    const next = getSafeNext(searchParams.get("next") || hashParams.get("next"));
    const code = searchParams.get("code");
    const tokenHash = searchParams.get("token_hash") || hashParams.get("token_hash");
    const type = searchParams.get("type") || hashParams.get("type");
    const accessToken = hashParams.get("access_token");
    const refreshToken = hashParams.get("refresh_token");
    const detected = [
      code ? "code" : null,
      tokenHash ? "token_hash" : null,
      accessToken ? "access_token" : null,
      refreshToken ? "refresh_token" : null,
      type ? `type=${type}` : null
    ].filter(Boolean);

    if (!code && !tokenHash && (!accessToken || !refreshToken)) {
      setMessage("El enlace no trae una sesión válida. Vuelve a pedir un enlace de acceso.");
      setDebug(`Parámetros detectados: ${detected.join(", ") || "ninguno"}.`);
      return;
    }

    const response = await fetch("/api/auth/callback", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        code,
        tokenHash,
        type,
        accessToken,
        refreshToken
      })
    });

    const payload = (await response.json().catch(() => null)) as { ok?: boolean; message?: string } | null;

    if (!response.ok || !payload?.ok) {
      setMessage(payload?.message ?? "No he podido confirmar la sesión. Vuelve a pedir un enlace de acceso.");
      setDebug(`Parámetros detectados: ${detected.join(", ") || "ninguno"}.`);
      return;
    }

    window.history.replaceState(null, "", window.location.pathname + window.location.search);
    window.location.replace(next);
  }

  confirmSession().catch(() => {
    setMessage("Ha ocurrido un error confirmando la sesión. Vuelve a pedir un enlace de acceso.");
  });
</script>

<style>
  .auth-callback {
    display: grid;
    place-items: center;
    min-height: calc(100vh - 96px);
  }

  .auth-callback__panel {
    display: grid;
    gap: var(--space-md);
    width: min(100%, 520px);
    padding: var(--space-xl);
    text-align: center;
    background: var(--glass-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-4xl);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--shadow-sm);
  }

  .auth-callback__debug {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.9rem;
  }
</style>
