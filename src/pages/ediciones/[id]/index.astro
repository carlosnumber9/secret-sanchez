---
import Button from "@/components/Button/Button.astro";
import Card from "@/components/Card/Card.astro";
import StatusBadge from "@/components/StatusBadge/StatusBadge.astro";
import EditionConfigurator from "@/components/react/EditionConfigurator/EditionConfigurator";
import RevokeDraw from "@/components/react/RevokeDraw/RevokeDraw";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getEditionAppState } from "@/actions/editionData";

const id = Astro.params.id!;
const state = await getEditionAppState(Astro.locals.admin.id, id);
const islandProps = state.islands.map(({ island, config }) => ({ id: island.id, name: island.name, color: island.color, enabled: config.enabled, representativeParticipantId: config.representativeParticipantId }));
const peopleProps = state.participants.map(({ participant, config }) => ({
  id: participant.id,
  islandId: participant.familyIslandId,
  name: participant.name,
  enabled: config.enabled,
  canGive: config.canGive,
  canReceive: config.canReceive,
  isBaby: config.isBaby,
  preferredChannel: config.preferredChannel === "manual" ? null : config.preferredChannel,
  hasEmail: Boolean(participant.email),
  hasPhone: Boolean(participant.phone)
}));
---
<AdminLayout title={state.edition.name}>
  <div class="section-header"><p>{state.edition.year}</p><h1>{state.edition.name}</h1><div class="cluster"><StatusBadge tone={state.edition.kind === "final" ? "ok" : "neutral"}>{state.edition.kind === "final" ? "Definitiva" : "Prueba"}</StatusBadge><StatusBadge tone="neutral">{state.edition.status}</StatusBadge></div></div>
  <div class="cluster cluster--actions"><Button href={`/ediciones/${id}/sorteo`} size="large">{state.currentDraw ? "Ver reparto" : "Ir al reparto"}</Button>{state.currentDraw && <Button href={`/ediciones/${id}/envios`} variant="secondary">Ver envíos</Button>}</div>
  <Card><div class="stack"><h2>Participantes y roles</h2><p>Los núcleos desactivados prevalecen sobre la configuración individual.</p><EditionConfigurator client:load editionId={id} initialIslands={islandProps} initialPeople={peopleProps} locked={Boolean(state.currentDraw)} /></div></Card>
  {state.currentDraw && <Card tone="warm"><div class="stack"><h2>Revertir intento {state.currentDraw.attemptNumber}</h2><RevokeDraw client:load editionId={id} drawId={state.currentDraw.id} exposure={state.exposure} /></div></Card>}
  {state.attempts.some((attempt) => attempt.status === "revoked") && <Card><div class="stack"><h2>Intentos anulados</h2>{state.attempts.filter((attempt) => attempt.status === "revoked").map((attempt) => <p>Intento {attempt.attemptNumber} · anulado {attempt.revokedAt?.toLocaleString("es-ES")}</p>)}</div></Card>}
</AdminLayout>
