---
import EditionWorkspace from "@/components/react/EditionWorkspace/EditionWorkspace";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getEditionAppState } from "@/actions/editionData";
import { editionView } from "@/lib/admin-view-models";

const state = editionView(await getEditionAppState(Astro.locals.admin.id, Astro.params.id!));
---
<AdminLayout title={state.edition.name}>
  <EditionWorkspace client:load initialState={state} />
</AdminLayout>
