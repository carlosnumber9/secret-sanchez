---
import Button from "@/components/Button/Button.astro";
import Card from "@/components/Card/Card.astro";
import { Input } from "@/components/ui/input";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSafeRedirectPath } from "@/lib/auth-redirect";
import { LockKeyhole, ShieldCheck, Sparkles } from "lucide-react";

const next = getSafeRedirectPath(Astro.url.searchParams.get("next"));
---

<BaseLayout title="Entrar como organizador | Secret Sánchez">
  <main class="login-main">
    <div class="page-shell login-page">
      <section class="login-page__hero">
        <a class="login-page__brand" href="/" aria-label="Secret Sánchez">
          <span class="login-page__brand-mark" aria-hidden="true">
            <img src="/favicon.svg" alt="" width="44" height="44" />
          </span>
          <span>
            <strong>Secret Sánchez</strong>
            <small>Reyes en familia</small>
          </span>
        </a>

        <div class="login-page__hero-copy">
          <p class="login-page__eyebrow">Organizador familiar</p>
          <h1>Todo el sorteo, sin estropear la sorpresa</h1>
          <p>
            Prepara la familia, genera el reparto y comparte cada enlace secreto desde un único lugar.
          </p>
        </div>

        <ul class="login-page__benefits">
          <li>
            <ShieldCheck size={20} aria-hidden="true" />
            <span>Acceso protegido para organizadores</span>
          </li>
          <li>
            <Sparkles size={20} aria-hidden="true" />
            <span>Los regalos siguen siendo secretos</span>
          </li>
        </ul>
      </section>

      <Card tone="accent" class="login-page__card">
        <div class="login-page__form-header">
          <span class="login-page__form-icon" aria-hidden="true">
            <LockKeyhole size={22} />
          </span>
          <div>
            <h2>Entrar como organizador</h2>
            <p>Usa las credenciales de tu cuenta autorizada.</p>
          </div>
        </div>

        <form class="login-page__form" id="password-login-form" data-next={next}>
          <label class="form-field">
            Email
            <Input
              className="h-11"
              name="email"
              type="email"
              inputMode="email"
              autoComplete="email"
              aria-describedby="email-help"
              placeholder="juan@email.com"
              required
            />
          </label>
          <p class="login-page__field-help" id="email-help">
            Usa el email autorizado para gestionar el sorteo.
          </p>
          <label class="form-field">
            Contraseña
            <Input
              className="h-11"
              name="password"
              type="password"
              autoComplete="current-password"
              placeholder="Tu contraseña"
              required
            />
          </label>
          <Button id="login-submit" class="min-h-11 w-full" type="submit" size="large">
            Entrar
          </Button>
          <p class="login-page__message" id="login-message" role="status" aria-live="polite"></p>
        </form>

        <div class="login-page__assurance">
          <ShieldCheck size={17} aria-hidden="true" />
          <p>Supabase valida la contraseña de forma segura. La aplicación no la almacena ni la registra.</p>
        </div>
      </Card>
    </div>
  </main>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#password-login-form");
  const message = document.querySelector<HTMLElement>("#login-message");
  const submitButton = document.querySelector<HTMLButtonElement>("#login-submit");

  if (form && message && submitButton) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = data.get("email");
      const password = data.get("password");
      message.textContent = "Comprobando credenciales...";
      message.dataset.state = "loading";
      submitButton.disabled = true;
      submitButton.setAttribute("aria-busy", "true");
      submitButton.textContent = "Entrando...";

      if (typeof email !== "string" || typeof password !== "string" || !password) {
        message.textContent = "Escribe un email y una contraseña válidos.";
        message.dataset.state = "error";
        submitButton.disabled = false;
        submitButton.removeAttribute("aria-busy");
        submitButton.textContent = "Entrar";
        return;
      }

      try {
        const response = await fetch("/api/auth/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, password })
        });
        const payload = (await response.json().catch(() => null)) as { ok?: boolean; message?: string } | null;
        if (response.ok && payload?.ok) {
          message.textContent = "Acceso correcto. Entrando...";
          message.dataset.state = "success";
          window.location.replace(form.dataset.next || "/");
          return;
        }

        message.textContent = payload?.message ?? "No se pudo iniciar sesión.";
        message.dataset.state = "error";
      } catch {
        message.textContent = "No se pudo iniciar sesión. Revisa la conexión y vuelve a intentarlo.";
        message.dataset.state = "error";
      } finally {
        submitButton.disabled = false;
        submitButton.removeAttribute("aria-busy");
        submitButton.textContent = "Entrar";
      }
    });
  }
</script>

<style>
  .login-main {
    display: grid;
    min-height: 100svh;
    align-items: center;
  }

  .login-page {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(340px, 460px);
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .login-page__hero {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    min-height: min(680px, calc(100svh - var(--page-block-space) - var(--page-block-space)));
    align-content: space-between;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    color: var(--primary-foreground);
    background: var(--glass-primary);
    border: 1px solid color-mix(in oklch, var(--primary) 82%, var(--border));
    border-radius: var(--radius-4xl);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--shadow-sm);
  }

  .login-page__brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.75rem;
  }

  .login-page__brand-mark {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-2xl);
    overflow: hidden;
  }

  .login-page__brand-mark img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .login-page__brand strong,
  .login-page__brand small {
    display: block;
  }

  .login-page__brand small {
    margin-top: 0.15rem;
    color: color-mix(in oklch, var(--primary-foreground) 76%, transparent);
    font-size: 0.8rem;
  }

  .login-page__hero-copy {
    display: grid;
    gap: var(--space-md);
    max-width: 660px;
  }

  .login-page__hero-copy p {
    color: color-mix(in oklch, var(--primary-foreground) 84%, transparent);
    max-width: 56ch;
    font-size: 1.05rem;
  }

  .login-page__eyebrow {
    font-size: 0.8rem !important;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .login-page__benefits {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .login-page__benefits li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: color-mix(in oklch, var(--primary-foreground) 88%, transparent);
    font-size: 0.9rem;
    font-weight: 500;
  }

  :global(.login-page__card) {
    width: 100%;
  }

  .login-page__form-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .login-page__form-header > div {
    display: grid;
    gap: 0.4rem;
  }

  .login-page__form-icon {
    display: grid;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    place-items: center;
    color: var(--primary);
    background: color-mix(in oklch, var(--primary) 10%, transparent);
    border-radius: var(--radius-2xl);
  }

  .login-page__form {
    display: grid;
    gap: var(--space-md);
  }

  .login-page__field-help {
    margin-top: -0.25rem;
    font-size: 0.8rem;
  }

  .login-page__message {
    display: none;
    padding: 0.75rem;
    border-radius: var(--radius-2xl);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .login-page__message:not(:empty) {
    display: block;
  }

  .login-page__message[data-state="loading"] {
    color: var(--muted-foreground);
    background: var(--muted);
  }

  .login-page__message[data-state="success"] {
    color: var(--chart-5);
    background: color-mix(in oklch, var(--chart-2) 14%, transparent);
  }

  .login-page__message[data-state="error"] {
    color: var(--destructive);
    background: color-mix(in oklch, var(--destructive) 10%, transparent);
  }

  .login-page__assurance {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    color: var(--muted-foreground);
    border-top: 1px solid var(--glass-border);
  }

  .login-page__assurance svg {
    flex: 0 0 auto;
    margin-top: 0.15rem;
  }

  .login-page__assurance p {
    font-size: 0.8rem;
    line-height: 1.5;
  }

  @media (max-width: 780px) {
    .login-page {
      grid-template-columns: 1fr;
    }

    .login-page__hero {
      min-height: auto;
    }
  }

  @media (max-width: 520px) {
    .login-page__hero {
      gap: var(--space-xl);
      padding: var(--space-lg);
    }

    .login-page__form-header {
      align-items: center;
    }
  }
</style>
