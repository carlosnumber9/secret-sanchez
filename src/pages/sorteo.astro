---
import Card from "@/components/Card/Card.astro";
import StatusBadge from "@/components/StatusBadge/StatusBadge.astro";
import DrawGenerator from "@/components/react/DrawGenerator/DrawGenerator";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getAdminAppState } from "@/actions/adminData";

const state = await getAdminAppState(Astro.locals.admin.id);
const participantCount = state.participants.filter((participant) => participant.active).length;
const invalidChannels = state.participants.filter(
  (participant) => participant.active && (participant.preferredChannel === "whatsapp" || participant.preferredChannel === "both")
).length;
const noSameIslandEnabled =
  state.rules.find((rule) => rule.type === "NO_SAME_ISLAND")?.enabled ?? true;
---

<AdminLayout title="Sorteo">
  <div class="section-header">
    <h1>Sorteo</h1>
    <p>Un botón grande, reglas claras y sin mostrar asignaciones completas para no estropear la sorpresa.</p>
  </div>

  <section class="two-column">
    <div class="stack">
      {
        state.group ? (
          state.draw ? (
            <Card tone="accent"><div class="stack"><h2>Sorteo realizado</h2><p>Ya existe un sorteo activo. Consulta y prepara las entregas desde Envíos.</p></div></Card>
          ) : (
            <DrawGenerator client:load groupId={state.group.id} participantCount={participantCount} />
          )
        ) : (
          <Card><p>Crea primero el grupo desde Inicio.</p></Card>
        )
      }
      <Card>
        <div class="stack">
          <h2>Después de repartir</h2>
          <p>La app genera un token secreto por participante, guarda solo el hash y prepara los mensajes.</p>
          <div class="cluster">
            <StatusBadge tone="neutral">Emails con Resend</StatusBadge>
            <StatusBadge tone={invalidChannels ? "warning" : "neutral"}>WhatsApp no disponible</StatusBadge>
          </div>
        </div>
      </Card>
    </div>

    <Card tone="warm">
      <div class="stack">
        <h2>Reglas activas</h2>
        <ul class="rules-list">
          <li>Nadie se regala a sí mismo.</li>
          <li>
            {noSameIslandEnabled
              ? "No se permiten regalos dentro del mismo núcleo familiar."
              : "Sí se permiten regalos dentro del mismo núcleo familiar."}
          </li>
          <li>Todos reciben un regalo.</li>
          <li>
            {state.exclusions.length
              ? `${state.exclusions.length} exclusiones manuales activas.`
              : "No hay exclusiones manuales."}
          </li>
        </ul>
      </div>
    </Card>
  </section>
</AdminLayout>

<style>
  .rules-list {
    display: grid;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rules-list li {
    padding: var(--space-md);
    background: var(--glass-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-2xl);
    backdrop-filter: var(--glass-blur);
    font-weight: 500;
  }
</style>
