---
import FamilyWorkspace from "@/components/react/FamilyWorkspace/FamilyWorkspace";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getAdminAppState } from "@/actions/adminData";
import { familyView } from "@/lib/admin-view-models";

const state = familyView(await getAdminAppState(Astro.locals.admin.id, { editions: false }));
---
<AdminLayout title="Familia">
  <div class="section-header"><h1>Familia</h1><p>Organiza el censo permanente por unidades. La participación y los roles se deciden dentro de cada edición.</p></div>
  <FamilyWorkspace client:load initialState={state} />
</AdminLayout>
