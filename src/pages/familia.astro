---
import FamilyEditor from "@/components/react/FamilyEditor/FamilyEditor";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getAdminAppState } from "@/actions/adminData";

const state = await getAdminAppState(Astro.locals.admin.id);
const islands = state.islands.map((island) => ({
  id: island.id,
  name: island.name,
  color: island.color ?? "#d6a84f",
  participants: state.participants.filter((participant) => participant.familyIslandId === island.id).map((participant) => ({
    id: participant.id,
    name: participant.name,
    email: participant.email ?? "",
    phone: participant.phone ?? "",
    preferredChannel: participant.preferredChannel === "manual" ? null : participant.preferredChannel,
    isBaby: participant.isBaby
  }))
}));
---

<AdminLayout title="Familia">
  <div class="section-header"><h1>Familia</h1><p>Este es el censo permanente. La participación y los roles se deciden dentro de cada edición.</p></div>
  {state.family ? <FamilyEditor client:load familyId={state.family.id} initialIslands={islands} /> : <p>Crea primero la familia desde <a href="/inicio">Inicio</a>.</p>}
</AdminLayout>
