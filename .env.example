PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Supabase Dashboard > Project Settings > Database > Connection string.
# Use the Transaction pooler URL for serverless deployments.
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Canonical origin of this environment, used in reveal links.
APP_URL=
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
REVEAL_TOKEN_ENCRYPTION_KEY=
RESEND_API_KEY=
KAPSO_API_KEY=
# Resend webhook signing secret; independent from the API key.
RESEND_WEBHOOK_SECRET=
# development by default. On Vercel, VERCEL_ENV always takes precedence.
APP_ENV=development
# Non-production requires these non-secret Production references and a separate project.
PRODUCTION_SUPABASE_URL=
PRODUCTION_APP_URL=
# Explicit safe email for non-production test editions.
NOTIFICATION_TEST_EMAIL=
KAPSO_PHONE_NUMBER_ID=
KAPSO_TEMPLATE_NAME=
KAPSO_TEMPLATE_LANGUAGE=
KAPSO_WEBHOOK_SECRET=
KAPSO_TEST_RECIPIENT_PHONE=
